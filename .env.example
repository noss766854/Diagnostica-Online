# Email and payments
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=http://localhost:3000

# Optional platform controls
MAX_DIAGNOSTIC_UPLOAD_MB=25
FREE_AI_MESSAGES_PER_DAY=5
PREMIUM_AI_MESSAGES_PER_DAY=100
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
